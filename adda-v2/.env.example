# Postgres: Akten und DuckLake-Katalog
LEDGER_PG_URL=postgres://ledger:ledger@127.0.0.1:5432/ledger
LEDGER_TEST_PG_URL=postgres://ledger:ledger@127.0.0.1:5432/ledger_test
# Parquet vom Stammverzeichnis. Nicht aus apps/api relativ setzen.
LEDGER_LAKE_PATH=./data/lake
LEDGER_API_HOST=0.0.0.0
LEDGER_API_PORT=5757
LEDGER_WEB_HOST=0.0.0.0
LEDGER_WEB_PORT=5759
# Leer = Aufnahme zu
LEDGER_INGEST_TOKEN=dev-ingest
# Akten, Pins, Dispositionen
LEDGER_OPERATOR_TOKEN=dev-operator
VITE_LEDGER_OPERATOR_TOKEN=dev-operator
